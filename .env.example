# Token Plan 凭证仅在本地环境配置；不要提交真实密钥。
PINTAN_MODEL_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 两类任务独立选模型；账户可用性仍需在线验证。
PINTAN_STABLE_MODEL=qwen3.6-flash
PINTAN_TRENDING_MODEL=qwen3.7-plus
# 本地调试默认关闭深度思考；设 true 可开启，但响应可能更慢。
PINTAN_ENABLE_THINKING=false

# 商品图片背景生成；商品主体始终从已授权原图抠取并由 Pillow 合成。
QWEN_IMAGE_MODEL=qwen-image-2.0
QWEN_IMAGE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
PINTAN_PARAMETER_MODEL=wan2.7-image-pro
# TTS 接口未配置或调用失败时，视频自动降级为无配音字幕版。
QWEN_TTS_MODEL=qwen-audio-3.0-tts-plus
QWEN_TTS_BASE_URL=
# 可填写 conda pintan 环境中 ffmpeg.exe 的绝对路径；留空则从 PATH 查找。
FFMPEG_PATH=

# 只有显式设置 PINTAN_MODEL_PROVIDER=deepseek 才读取以下配置。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
